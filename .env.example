# ===========================================
# GiftForge — пример файла конфигурации
# Скопируй этот файл как .env и заполни значения
# ===========================================

# --- Telegram Bot ---
# Получи токен у @BotFather командой /newbot
BOT_TOKEN=your_telegram_bot_token_here

# Твой Telegram User ID (получи у @userinfobot)
ADMIN_TELEGRAM_ID=123456789

# Юзернейм бота (без @)
BOT_USERNAME=your_bot_username

# --- Сервер ---
# Порт backend API (не менять без необходимости)
API_PORT=3001

# Порт frontend (не менять без необходимости)
FRONTEND_PORT=5173

# --- База данных ---
# SQLite для разработки (путь относительно packages/backend)
DATABASE_URL="file:./dev.db"

# --- Безопасность ---
# Секрет для подписи сессий (замени на случайную строку)
SESSION_SECRET=change_this_to_a_random_secret_string_at_least_32_chars

# --- Режим работы ---
# true = демо-режим (без Telegram), false = продакшен
DEMO_MODE=true

# NODE_ENV: development / production
NODE_ENV=development

# --- URL приложения ---
# Публичный HTTPS адрес (нужен для Telegram Mini App)
# Для разработки оставь пустым
APP_URL=https://your-domain.com
