# ===========================================
# GiftForge — пример файла конфигурации
# Скопируй этот файл как .env и заполни значения
# ===========================================

# --- Telegram Bot ---
# Получи токен у @BotFather командой /newbot
BOT_TOKEN=your_telegram_bot_token_here

# Твой Telegram User ID (получи у @userinfobot)
ADMIN_TELEGRAM_ID=123456789

# Юзернейм бота (без @)
BOT_USERNAME=your_bot_username

# --- Сервер ---
API_PORT=3001
FRONTEND_PORT=5173

# --- База данных ---
# Для разработки (SQLite):
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"

# Для продакшена на Railway (PostgreSQL) — Railway выдаст эти значения сам:
# DATABASE_PROVIDER=postgresql
# DATABASE_URL="postgresql://user:pass@host:5432/dbname"

# --- Безопасность ---
SESSION_SECRET=change_this_to_a_random_secret_string_at_least_32_chars

# --- Режим работы ---
# true = демо-режим (без Telegram), false = продакшен
DEMO_MODE=true
NODE_ENV=development

# --- URL приложения ---
# Публичный HTTPS адрес Mini App (Vercel URL после деплоя)
APP_URL=https://your-app.vercel.app
